<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="656.0" prefWidth="976.0" style="-fx-background-color: #F2F0EB;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0">
         <Label text="Nome da Tarefa:">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
         <TextField fx:id="campoNomeTarefa" />
         <Label text="Descrição da Tarefa" translateY="20.0">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
         <TextField fx:id="campoDescricaoTarefa" translateY="20.0" />
         <Label text="Prazo:" translateY="80.0">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
         <DatePicker translateY="80.0" />
         <Spinner translateX="200.0" translateY="55.0" />
         <Label text="Prioridade:" translateY="100.0">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
         </Label>
         <ComboBox editable="true" prefWidth="150.0" translateY="100.0" />
         <Button fx:id="botaoSalvar" mnemonicParsing="false" style="-fx-background-color: #2E7D32;" text="Salvar" textFill="WHITE" translateX="510.0" translateY="150.0">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Button>
         <Button fx:id="botaoCancelar" mnemonicParsing="false" style="-fx-background-color: #2E7D32;" text="Cancelar" textFill="WHITE" translateX="430.0" translateY="125.0">
            <font>
               <Font name="System Bold" size="12.0" />
            </font>
         </Button>
      </VBox>
   </center>
   <top>
      <VBox prefHeight="93.0" prefWidth="976.0" style="-fx-background-color: #2E7D32;" BorderPane.alignment="CENTER">
         <Label text="Nova Tarefa" textFill="#f2f0eb" translateX="390.0" translateY="20.0">
            <font>
               <Font name="Goudy Old Style Bold" size="35.0" />
            </font>
         </Label>
      </VBox>
   </top>
</BorderPane>
