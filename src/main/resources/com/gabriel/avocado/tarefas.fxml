            <Label text="Pesquisar Tarefas:">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <TextField style="-fx-background-color: #F54G;" />
         </children>
      </VBox>
   </center>
   <right>
      <Button fx:id="emTarefa" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" onAction="#aoTarefas" style="-fx-background-color: #2E7D32;" text="+ Nova Tarefa" textFill="WHITE" translateX="-30.0" translateY="-250.0" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Button>
   </right>
   <top>
      <Button minWidth="33.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="33.0" style="-fx-background-color: #2E7D32;" text="Voltar" translateX="-500.0" translateY="20.0" BorderPane.alignment="CENTER">
         <font>
            <Font size="44.0" />
         </font>
      </Button>
