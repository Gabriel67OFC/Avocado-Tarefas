<?import javafx.scene.text.Font?>

<BorderPane prefHeight="699.0" prefWidth="1142.0" style="-fx-background-color: #F2F0EB;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <center>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0">
